	<Application Name="Timing" Comment="Small test application for measuring the execution time of a few fbs for evaluating runtime performance">
		<SubAppNetwork>
			<FB Name="CSV_WRITER_1" Type="eclipse4diac::utils::CSV_WRITER_1" x="2600" y="1000">
				<Parameter Name="FILE_NAME" Value="executiontime.csv"/>
			</FB>
			<FB Name="E_SR" Type="iec61499::events::E_SR" x="400" y="700">
			</FB>
			<FB Name="E_SWITCH_2" Type="iec61499::events::E_SWITCH" x="-700" y="1600">
			</FB>
			<FB Name="Iterations" Type="iec61499::events::E_CTU" x="-1400" y="1600">
				<Parameter Name="PV" Value="1000"/>
			</FB>
			<SubApp Name="FBNuTest" x="200" y="1600">
				<SubAppInterfaceList>
					<SubAppEventInputs>
						<SubAppEvent Name="Start" Type="Event">
						</SubAppEvent>
					</SubAppEventInputs>
					<SubAppEventOutputs>
						<SubAppEvent Name="Done" Type="Event">
						</SubAppEvent>
					</SubAppEventOutputs>
					<InputVars>
						<VarDeclaration Name="iterations" Type="UINT" InitialValue="100"/>
					</InputVars>
				</SubAppInterfaceList>
				<SubAppNetwork>
					<FB Name="E_CTU" Type="iec61499::events::E_CTU" x="900" y="300">
					</FB>
					<FB Name="E_SWITCH_1" Type="iec61499::events::E_SWITCH" x="1500" y="300">
					</FB>
					<FB Name="E_SWITCH" Type="iec61499::events::E_SWITCH" x="3300" y="300">
					</FB>
					<FB Name="E_CTU_1" Type="iec61499::events::E_CTU" x="2700" y="300">
						<Parameter Name="PV" Value="65500"/>
					</FB>
					<EventConnections>
						<Connection Source="E_CTU_1.RO" Destination="E_CTU.CU"/>
						<Connection Source="E_SWITCH_1.EO1" Destination="E_CTU.R" dx1="39.13" dx2="-304.35" dy="473.91"/>
						<Connection Source="E_CTU.CUO" Destination="E_SWITCH_1.EI"/>
						<Connection Source="E_SWITCH_1.EO0" Destination="E_CTU_1.CU" dx1="343.48"/>
						<Connection Source="E_CTU_1.CUO" Destination="E_SWITCH.EI"/>
						<Connection Source="E_SWITCH.EO0" Destination="E_CTU_1.CU" dx1="256.52" dx2="-404.35" dy="708.7"/>
						<Connection Source="E_SWITCH.EO1" Destination="E_CTU_1.R" dx1="-13.04" dx2="-304.35" dy="486.96"/>
						<Connection Source="Start" Destination="E_CTU.CU" dx1="373.91"/>
						<Connection Source="E_CTU.RO" Destination="Done"/>
					</EventConnections>
					<DataConnections>
						<Connection Source="E_CTU.Q" Destination="E_SWITCH_1.G"/>
						<Connection Source="E_CTU_1.Q" Destination="E_SWITCH.G"/>
						<Connection Source="iterations" Destination="E_CTU.PV"/>
					</DataConnections>
				</SubAppNetwork>
				<Attribute Name="width" Type="LREAL" Value="3000"/>
				<Attribute Name="height" Type="LREAL" Value="1700"/>
			</SubApp>
			<FB Name="STEST_END" Type="eclipse4diac::utils::STEST_END" x="4700" y="1000">
			</FB>
			<FB Name="E_SWITCH" Type="iec61499::events::E_SWITCH" x="3800" y="1000">
			</FB>
			<FB Name="E_StopWatch" Type="eclipse4diac::utils::timing::E_STOPWATCH" x="1200" y="1300">
			</FB>
			<EventConnections>
				<Connection Source="E_SR.EO" Destination="CSV_WRITER_1.INIT" dx1="1488.24"/>
				<Connection Source="Iterations.CUO" Destination="E_SWITCH_2.EI"/>
				<Connection Source="E_SWITCH_2.EO1" Destination="Iterations.R" dx1="58.82" dx2="258.82" dy="552.94"/>
				<Connection Source="Iterations.RO" Destination="E_SR.R" dx1="94.12"/>
				<Connection Source="E_SWITCH_2.EO0" Destination="FBNuTest.Start"/>
				<Connection Source="E_SWITCH.EO1" Destination="Iterations.CU" dx1="58.82" dx2="388.24" dy="1323.53"/>
				<Connection Source="E_SWITCH.EO0" Destination="STEST_END.REQ"/>
				<Connection Source="CSV_WRITER_1.INITO" Destination="E_SWITCH.EI"/>
				<Connection Source="E_SWITCH_2.EO0" Destination="E_StopWatch.START" dx1="123.53"/>
				<Connection Source="FBNuTest.Done" Destination="E_StopWatch.STOP" dx1="211.76"/>
				<Connection Source="E_StopWatch.EO" Destination="CSV_WRITER_1.REQ" dx1="70.59"/>
				<Connection Source="CSV_WRITER_1.CNF" Destination="Iterations.CU" dx1="58.82" dx2="58.82" dy="-617.65"/>
			</EventConnections>
			<DataConnections>
				<Connection Source="E_SR.Q" Destination="CSV_WRITER_1.QI" dx1="1447.06"/>
				<Connection Source="Iterations.Q" Destination="E_SWITCH_2.G"/>
				<Connection Source="CSV_WRITER_1.QO" Destination="E_SWITCH.G"/>
				<Connection Source="E_StopWatch.TD" Destination="CSV_WRITER_1.SD_1" dx1="300"/>
			</DataConnections>
		</SubAppNetwork>
	</Application>
	<Application Name="Soft_Pass_Example">
