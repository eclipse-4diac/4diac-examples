		</ECC>
		<Algorithm Name="AND" Comment="new algorithm">
			<ST><![CDATA[OUT:=(A and B and C);]]></ST>
		</Algorithm>
		<Algorithm Name="OR" Comment="new algorithm">
			<ST><![CDATA[OUT:=(A or B);]]></ST>
		</Algorithm>
		<Algorithm Name="XOR" Comment="new algorithm">
			<ST><![CDATA[OUT:=(A XOR B);]]></ST>
		</Algorithm>
		<Algorithm Name="NOT" Comment="new algorithm">
			<ST><![CDATA[OUT:=NOT A;]]></ST>
		</Algorithm>
	</BasicFB>
</FBType>
