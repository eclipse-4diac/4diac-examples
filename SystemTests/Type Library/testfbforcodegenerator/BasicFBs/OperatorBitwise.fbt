	<VersionInfo Version="1.0" Author="jholz" Date="2019-06-05">
	</VersionInfo>
	<CompilerInfo packageName="testfbforcodegenerator::BasicFBs">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="AND_" Type="Event">
				<With Var="A"/>
				<With Var="B"/>
				<With Var="C"/>
			</Event>
			<Event Name="OR_" Type="Event">
				<With Var="A"/>
				<With Var="B"/>
				<With Var="C"/>
			</Event>
			<Event Name="XOR_" Type="Event">
				<With Var="A"/>
				<With Var="B"/>
				<With Var="C"/>
			</Event>
			<Event Name="NOT_" Type="Event">
				<With Var="A"/>
				<With Var="B"/>
				<With Var="C"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="EO" Type="Event">
				<With Var="OUT"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="A" Type="BYTE"/>
			<VarDeclaration Name="B" Type="BYTE"/>
			<VarDeclaration Name="C" Type="BYTE"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="OUT" Type="BYTE"/>
		</OutputVars>
	</InterfaceList>
	<BasicFB>
		<ECC>
			<ECState Name="START" Comment="Initial State" x="4300" y="1900">
			</ECState>
			<ECState Name="State_1" x="4590" y="545">
				<ECAction Algorithm="AND" Output="EO"/>
			</ECState>
			<ECState Name="State_2" x="7055" y="1570">
				<ECAction Algorithm="OR" Output="EO"/>
			</ECState>
			<ECState Name="State_3" x="6220" y="2925">
				<ECAction Algorithm="XOR" Output="EO"/>
			</ECState>
			<ECState Name="State_4" x="4225" y="3050">
				<ECAction Algorithm="NOT" Output="EO"/>
			</ECState>
			<ECTransition Source="State_1" Destination="START" Condition="1" x="5135" y="1250"/>
			<ECTransition Source="START" Destination="State_1" Condition="AND_" x="4385" y="1185"/>
			<ECTransition Source="START" Destination="State_2" Condition="OR_" x="5845" y="1465"/>
			<ECTransition Source="START" Destination="State_3" Condition="XOR_" x="5585" y="2270"/>
			<ECTransition Source="START" Destination="State_4" Condition="NOT_" x="4400" y="2540"/>
